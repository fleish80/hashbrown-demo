# google, anthropic, openai or replay. When unset: google if GEMINI_API_KEY is set, then anthropic, then openai.
# replay streams recorded runs from FIXTURES_DIR and never calls a model: deterministic demos, works offline.
LLM_PROVIDER=google

GEMINI_API_KEY=
# comma-separated: the first is used, the rest are fallbacks when Google reports it overloaded.
# Keep to Gemini 3+: 2.5 models reject tool calls combined with JSON output (generative UI needs both).
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Claude. Leave ANTHROPIC_API_KEY empty to use an `ant auth login` profile instead (LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Optional: a named `ant` profile, e.g. one signed in with a personal account (ant --profile personal auth login).
# ANTHROPIC_PROFILE=personal
CLAUDE_MODEL=claude-opus-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Replay. With a real provider, RECORD_FIXTURES=true also saves every finished run to FIXTURES_DIR,
# ready for LLM_PROVIDER=replay. REPLAY_DELAY_MS is the pause between replayed events.
FIXTURES_DIR=fixtures
REPLAY_DELAY_MS=15
RECORD_FIXTURES=false

# How long (ms) a model may stay silent before the run falls back to the next model.
MODEL_FIRST_EVENT_TIMEOUT_MS=20000
API_PORT=3333
